ry"/></mxCell><mxCell id="n12" value="ติดตามความคืบหน้าและกิจกรรมทีมแบบเรียลไทม์" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=12;fontFamily=Tahoma;fontColor=#000000;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="230" y="390" width="350" height="50" as="geometry"/></mxCell><mxCell id="n13" value="บริหารจัดการทีมและกำหนดตำแหน่งงาน (Team &amp; Positions)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=12;fontFamily=Tahoma;fontColor=#000000;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="230" y="480" width="350" height="50" as="geometry"/></mxCell><mxCell id="n14" value="สร้างชิ้นงานและมอบหมายงานผลิต (Content &amp; Tasks)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=12;fontFamily=Tahoma;fontColor=#000000;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="230" y="550" width="350" height="50" as="geometry"/></mxCell><mxCell id="n15" value="ตรวจรับ สั่งแก้ไข และอนุมัติชิ้นงาน (Review &amp; Approval)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=12;fontFamily=Tahoma;fontColor=#000000;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="230" y="620" width="350" height="50" as="geometry"/></mxCell><mxCell id="n16" value="เผยแพร่ผลงานสู่สาธารณะ (Publish Content)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=12;fontFamily=Tahoma;fontColor=#000000;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="230" y="690" width="350" height="50" as="geometry"/></mxCell><mxCell id="n17" value="บริหารจัดการผู้ใช้งาน ทีมงาน และสิทธิ์ระบบ (RBAC)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=12;fontFamily=Tahoma;f